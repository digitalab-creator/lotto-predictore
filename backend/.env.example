# Database (PostgreSQL). Match user/db to your docker-compose or host.
DATABASE_URL=postgresql+psycopg2://lotto_user:lotto_pass@db:5432/lotto_db

# Magayo API (required for import_draws_magayo.py and fetch_latest_draw.py)
MAGAYO_API_KEY=your_magayo_api_key
MAGAYO_GAME_CODE=il_lotto

# Used by cron service to call backend
BACKEND_URL=http://backend:8000

# Optional
LOG_LEVEL=INFO
