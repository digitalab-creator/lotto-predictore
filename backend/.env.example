# Copy to backend/.env (never commit .env)
# See repo root .env.example for full inventory and file references.

# config.py + Alembic (env.py reads DATABASE_URL when running migrations)
DATABASE_URL=postgresql://lotto_user:lotto_pass@db:5432/lotto_db

# fetch_latest_draw, import_draws_magayo (optional — not the daily path)
MAGAYO_API_KEY=
MAGAYO_GAME_CODE=

# 1 = official Pais CSV via Oxylabs (COURT_PROXY + OXYLABS_* in cron/.env). 0 = old paisapi path.
PAIS_OFFICIAL_CSV_ENABLED=1

# shared/logging_service.py
LOG_DIR=/app/logs
LOG_LEVEL=INFO

# send_best_model_email.py, generate_weekly_tables.py → email microservice
EMAIL_SERVICE_URL=http://email-service:8000

# Weekly jobs + post-draw pack email/WhatsApp (default off if unset)
# WEEKLY_EMAIL_AND_JOBS_ENABLED=false

# generate_weekly_combinations.py — backend API base (localhost when script runs on host)
BACKEND_URL=http://localhost:8000
