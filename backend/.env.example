# Copy to backend/.env (never commit .env)
# Used by: backend config, Alembic when DATABASE_URL is exported

DATABASE_URL=postgresql://lotto_user:lotto_pass@db:5432/lotto_db

# Magayo import / fetch-latest-draw (optional if you use that source)
MAGAYO_API_KEY=
MAGAYO_GAME_CODE=

LOG_DIR=/app/logs
LOG_LEVEL=INFO

# Scripts that call the email microservice (default matches Docker service name)
EMAIL_SERVICE_URL=http://email-service:8000
