# Optional: use with Docker Compose `env_file` on the cron service, or export on the host.
# See repo root .env.example for descriptions. Compose currently sets many of these inline.

BACKEND_URL=http://backend:8000
EMAIL_SERVICE_URL=http://email-service:8000
DATABASE_URL=postgresql://lotto_user:lotto_pass@db:5432/lotto_db

# Google Cloud Storage upload in job_handlers (skipped if empty)
GCS_BUCKET_NAME=

LOG_DIR=/app/logs
LOG_LEVEL=INFO

# Process timezone for schedule (Sunday job times)
TZ=UTC

# Optional: path to service account JSON if not using gcloud config volume
# GOOGLE_APPLICATION_CREDENTIALS=
# Official Pais download. Quote the password when it contains = or +.
# Real values belong in cron/.env, which git ignores.
OXYLABS_PROXY_USER=
OXYLABS_PROXY_PASS=
COURT_PROXY=
PAIS_OFFICIAL_CSV_ENABLED=1
