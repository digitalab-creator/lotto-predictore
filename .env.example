# =============================================================================
# Lotto Predictore — FULL environment inventory (verified vs repo)
# =============================================================================
# Copy the section that matches each service:
#   backend/.env          ← backend/.env.example
#   email-service/.env    ← email-service/.env.example
#   cron                  ← cron/.env.example (compose sets some inline; add file if you prefer)
#
# docker-compose.yml also sets Postgres and some service env inline — see bottom.
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND (backend/config.py, alembic, scripts, services)
# -----------------------------------------------------------------------------
# DATABASE_URL          — SQLAlchemy + Alembic (required for migrations if not exported)
# MAGAYO_API_KEY        — sync_draws / fetch_latest_draw (numbers-only after Pais API stops)
# MAGAYO_GAME_CODE      — same
# LOG_DIR               — shared/logging_service.py (backend uses shared logger)
# LOG_LEVEL             — shared/logging_service.py
# EMAIL_SERVICE_URL     — backend/scripts/send_best_model_email.py, generate_weekly_tables.py
# BACKEND_URL           — backend/scripts/generate_weekly_combinations.py (API base; default http://localhost:8000)
# PRODUCTION_MAIN_ALGO  — fallback main when scoreboard empty or n < WALK_FORWARD_MIN_DRAWS_FOR_EDGE
# PRODUCTION_STRONG_ALGO — fallback strong for same cases
# PRODUCTION_FALLBACK_MAIN — default diversified_random when no predictive edge
# PRODUCTION_FALLBACK_STRONG — default random strong for no-edge packs
# WALK_FORWARD_MIN_TRAINING_DRAWS — expanding window minimum (default 200)
# WALK_FORWARD_MIN_DRAWS_FOR_EDGE — need this many scored draws before trusting winner (default 300)
# WALK_FORWARD_RANDOM_BOOTSTRAP_SAMPLES — random baseline replicates (default 500)
# PUBLIC_BASE_URL / BACKEND_PUBLIC_URL — links in pack email/WhatsApp (e.g. https://lotto.example.com)
# WHATSAPP_TOKEN — Meta Cloud API bearer (optional; email still sends if missing)
# WHATSAPP_PHONE_NUMBER_ID — Cloud API phone number id
# WHATSAPP_TO — E.164 recipient without +
# WHATSAPP_GRAPH_VERSION — default v21.0

# -----------------------------------------------------------------------------
# EMAIL SERVICE (email-service/src/email_service.py)
# -----------------------------------------------------------------------------
# SMTP_HOST             — default smtp.gmail.com (Elastic Email: smtp.elasticemail.com)
# SMTP_PORT             — default 587 (Elastic Email often 2525)
# SMTP_USERNAME         — required for send
# SMTP_PASSWORD         — required for send
# SENDER_EMAIL          — required
# SENDER_NAME           — optional; quote in .env if it contains spaces
# RECIPIENT_EMAIL       — required
# SMTP_STARTTLS         — optional, default true (set false only for plain SMTP)

# -----------------------------------------------------------------------------
# CRON (cron/api_endpoints.py, scheduler.py, error_handler.py, job_handlers.py)
# -----------------------------------------------------------------------------
# BACKEND_URL           — default http://backend:8000
# EMAIL_SERVICE_URL     — default http://email-service:8000
# DATABASE_URL          — job_handlers backup_database(); default in code matches compose-style URL
# GCS_BUCKET_NAME       — job_handlers upload_to_cloud_storage(); if unset, upload skipped
# LOG_DIR               — shared logging
# LOG_LEVEL             — shared logging
# TZ                    — schedule library uses process local time (set for correct Sunday jobs)
# GOOGLE_APPLICATION_CREDENTIALS — optional path to GCP key JSON (else use gcloud ADC / compose volume)

# -----------------------------------------------------------------------------
# OPTIONAL: scripts/git_manager.py (host / CI, not Docker services)
# -----------------------------------------------------------------------------
# GITHUB_REPO_URL
# GITHUB_TOKEN
# GIT_AUTHOR_NAME
# GIT_AUTHOR_EMAIL
# GIT_BRANCH            — default main

# -----------------------------------------------------------------------------
# docker-compose.yml — `db` service (not read by Python; set in compose or override)
# -----------------------------------------------------------------------------
# POSTGRES_USER
# POSTGRES_PASSWORD
# POSTGRES_DB

# -----------------------------------------------------------------------------
# Quick paste blocks (uncomment and copy)
# -----------------------------------------------------------------------------

# --- backend/.env ---
# DATABASE_URL=postgresql://lotto_user:lotto_pass@db:5432/lotto_db
# MAGAYO_API_KEY=
# MAGAYO_GAME_CODE=
# LOG_DIR=/app/logs
# LOG_LEVEL=INFO
# EMAIL_SERVICE_URL=http://email-service:8000
# BACKEND_URL=http://localhost:8000

# --- email-service/.env ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SENDER_EMAIL=
# SENDER_NAME=Lotto Predictor
# RECIPIENT_EMAIL=

# --- cron (add to compose or cron/.env) ---
# BACKEND_URL=http://backend:8000
# EMAIL_SERVICE_URL=http://email-service:8000
# DATABASE_URL=postgresql://lotto_user:lotto_pass@db:5432/lotto_db
# GCS_BUCKET_NAME=
# LOG_DIR=/app/logs
# LOG_LEVEL=INFO
# TZ=UTC
# GOOGLE_APPLICATION_CREDENTIALS=
