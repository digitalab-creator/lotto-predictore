# =============================================================================
# Lotto Predictore — environment reference
# =============================================================================
# Docker Compose loads:
#   - backend/.env          → backend service (copy from backend/.env.example)
#   - email-service/.env  → email service   (copy from email-service/.env.example)
# Cron + DB passwords are also set in docker-compose.yml; override with real
# secrets in compose or env files before production.
# =============================================================================

# --- Backend (put these in backend/.env) -------------------------------------
# DATABASE_URL=postgresql://lotto_user:lotto_pass@db:5432/lotto_db
# MAGAYO_API_KEY=
# MAGAYO_GAME_CODE=
# LOG_DIR=/app/logs
# LOG_LEVEL=INFO
# EMAIL_SERVICE_URL=http://email-service:8000

# --- Email service (put these in email-service/.env) -------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SENDER_EMAIL=
# SENDER_NAME=Lotto Predictor
# RECIPIENT_EMAIL=

# --- Cron container (set in compose or cron service env) --------------------
# BACKEND_URL=http://backend:8000
# EMAIL_SERVICE_URL=http://email-service:8000
# DATABASE_URL=postgresql://lotto_user:lotto_pass@db:5432/lotto_db
# GCS_BUCKET_NAME=
# LOG_DIR=/app/logs
# LOG_LEVEL=INFO
# TZ=UTC

# --- Optional: scripts/git_manager.py ---------------------------------------
# GITHUB_REPO_URL=
# GITHUB_TOKEN=
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_BRANCH=main
