# ===================================================================
# 🏴‍☠️ LOTTO PREDICTORE - ENVIRONMENT VARIABLES TEMPLATE
# May the Flying Spaghetti Monster bless this configuration! 🍝
# ===================================================================
#
# This file contains all environment variables used in the Lotto Predictore app.
# Copy this file to create your environment-specific .env files:
#   - .env.development (for local development)
#   - backend/.env (for backend service)
#   - email-service/.env (for email service)
#   - cron/.env (for cron service)
#

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================
# PostgreSQL database connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://lotto_user:lotto_pass@db:5432/lotto_db

# Alternative format for SQLAlchemy (if needed)
# DATABASE_URL=postgresql+psycopg2://lotto_user:lotto_pass@localhost:5432/lotto_db

# ===================================================================
# REDIS CONFIGURATION
# ===================================================================
# Redis connection URL for caching and queue management
# Format: redis://HOST:PORT/DATABASE_NUMBER
REDIS_URL=redis://redis:6379/0

# ===================================================================
# LOGGING CONFIGURATION
# ===================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Directory where log files are stored
LOG_DIR=/app/logs

# ===================================================================
# MAGAYO API CONFIGURATION (Data Import Service)
# ===================================================================
# API key for Magayo Lotto service
# Get your API key from: https://www.magayo.com/api/
MAGAYO_API_KEY=your_magayo_api_key_here

# Game code for Magayo API (e.g., il_lotto for Israel Lotto)
MAGAYO_GAME_CODE=il_lotto

# ===================================================================
# SERVICE NAME CONFIGURATION
# ===================================================================
# Name of the service (backend, cron, email-service, worker, etc.)
SERVICE_NAME=backend

# ===================================================================
# MICROSERVICES URLs
# ===================================================================
# Backend API base URL
BACKEND_URL=http://backend:8000
API_BASE_URL=http://localhost:8000

# Email service URL
EMAIL_SERVICE_URL=http://email-service:8000

# ===================================================================
# EMAIL CONFIGURATION (for email-service)
# ===================================================================
# SMTP server configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# SMTP authentication credentials
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here

# Email sender information
SENDER_EMAIL=your_email@gmail.com
SENDER_NAME=Lotto Predictor

# Recipient email for notifications
RECIPIENT_EMAIL=recipient@example.com

# Admin email recipients (comma-separated for multiple recipients)
ADMIN_EMAIL_RECIPIENTS=admin1@example.com,admin2@example.com

# ===================================================================
# GOOGLE CLOUD STORAGE (for backups)
# ===================================================================
# GCS bucket name for database backups
GCS_BUCKET_NAME=lotto-predictor-backups

# ===================================================================
# GIT/GITHUB CONFIGURATION (for automated commits)
# ===================================================================
# GitHub repository URL
GITHUB_REPO_URL=https://github.com/your-username/lotto-predictore.git

# GitHub personal access token (for automated commits)
# Create token at: https://github.com/settings/tokens
# Required scopes: repo (full control of private repositories)
GITHUB_TOKEN=your_github_token_here

# Git author information
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=your.email@example.com

# Default branch for commits
GIT_BRANCH=main

# ===================================================================
# DOCKER CONFIGURATION
# ===================================================================
# User and group IDs for Docker containers
# Default: 1001:1002
# USER_ID=1001
# GROUP_ID=1002

# ===================================================================
# NOTES FOR DEVELOPERS
# ===================================================================
# 
# 1. NEVER commit actual .env files with real credentials to version control
# 2. Each service may use a subset of these variables:
#    - backend: DATABASE_URL, REDIS_URL, MAGAYO_*, LOG_*, EMAIL_SERVICE_URL
#    - email-service: SMTP_*, SENDER_*, RECIPIENT_*, ADMIN_EMAIL_RECIPIENTS
#    - cron: BACKEND_URL, DATABASE_URL, GCS_BUCKET_NAME, LOG_*
#    - worker: DATABASE_URL, REDIS_URL, LOG_*
# 3. For Gmail SMTP, you need an "App Password" (not your regular password):
#    https://support.google.com/accounts/answer/185833
# 4. Make sure to update the .gitignore to exclude all .env* files except .env.example
# 5. For local development, copy this file:
#    cp .env.example .env.development
# 6. For production, use strong passwords and keep credentials secure!
#
# Fair winds and clean configs to ye, pirate dev! 🏴‍☠️
# ===================================================================
