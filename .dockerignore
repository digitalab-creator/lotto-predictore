# Git and version control
.git/
.gitignore
.gitattributes

# Documentation
README.md
docs/
*.md

# Virtual Environment - Don't copy venv into containers
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Build artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

# Logs - Don't copy logs into containers (they'll be mounted)
logs/
*.log
*.log.*
cron_fetch_latest.log
cron_weekly_winning.log

# Database files and backups - Don't copy database files
backups/
*.db
*.sqlite3
*.sql
*.sql.gz
*.dump

# Cache directories - Don't copy cache
shared/cache/
*.cache
*.tmp
*.temp

# Large model files - Don't copy ML models (they'll be mounted or downloaded)
*.pkl
*.joblib
*.h5
*.model
*.weights
grid_search_results.json

