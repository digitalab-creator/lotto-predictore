# Copy to email-service/.env (never commit .env)
# See repo root .env.example for full inventory.

# Example: Elastic Email (same provider as n8n often uses)
# SMTP_HOST=smtp.elasticemail.com
# SMTP_PORT=2525
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=
SENDER_NAME=Digitalab Lotto Predictor
RECIPIENT_EMAIL=
# Set false only if your relay uses plain SMTP (no STARTTLS)
SMTP_STARTTLS=true
